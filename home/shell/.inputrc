# ==============================================================================
# .inputrc - GNU Readline Configuration
# ==============================================================================
# This file configures the behavior of readline, the library used by bash and
# other CLI programs for line editing and history navigation.
#
# WHAT IS READLINE?
#   Readline is the library that handles:
#   - Command line editing (cursor movement, text editing)
#   - History navigation (up/down arrows)
#   - Tab completion
#   - Keyboard shortcuts (Ctrl+A, Ctrl+E, etc.)
#
# WHEN LOADED:
#   - Automatically by Bash on startup (before .bashrc)
#   - Also used by: python REPL, gdb, psql, mysql, irb, node REPL
#   - NOT used by: Zsh (uses its own ZLE), Fish
#
# USAGE:
#   1. Symlink this file to ~/.inputrc (done automatically by install.sh)
#   2. Restart your shell or run: bind -f ~/.inputrc
#   3. Start typing commands and use shortcuts below
#
# EXAMPLES:
#   - Type "cd /u" then press TAB → auto-completes to "cd /usr/"
#   - Press Ctrl+R → search command history backwards
#   - Press Alt+. → insert last argument from previous command
#   - Press Up → cycle through history matching current input
#   - Type "git st" and press Up → only shows "git st*" commands
#
# OVERLAP WITH .bashrc:
#   Bash's `bind` builtin can also configure readline at runtime.
#   If .bashrc contains `bind` commands, they run AFTER this file loads
#   and will override any conflicting settings here. Keep all readline
#   config in this file for clarity; use `bind -P` to verify active bindings.
#
# DEPENDENCIES:
#   - GNU Readline 6.3+ (for colored-stats, colored-completion-prefix)
#   - Bash 4.4+ for full color completion support
#   - A terminal that sends standard ANSI escape sequences
# ==============================================================================

# ------------------------------------------------------------------------------
# Vi Mode Configuration (Recommended for Vim users)
# ------------------------------------------------------------------------------
# Uncomment these lines if you prefer Vi-style editing
# This gives you modal editing like in Vim (Normal/Insert mode)

# set editing-mode vi
# set keymap vi-command

# ------------------------------------------------------------------------------
# Emacs Mode (Default - Enabled)
# ------------------------------------------------------------------------------
# Emacs-style keybindings (Ctrl+A, Ctrl+E, etc.)
# This is the default mode and works well for most users

set editing-mode emacs

# ------------------------------------------------------------------------------
# General Behavior Settings
# ------------------------------------------------------------------------------

# Enable 8-bit input — allows typing accented/international characters
# without converting them to ASCII escape sequences
set input-meta on
set output-meta on
# Don't strip the 8th bit from input characters (needed for UTF-8)
set convert-meta off

# Silence the terminal bell on completion errors and ambiguous matches
# Options: none, visible (flash), audible (beep)
set bell-style none

# Show all completions immediately (no need to press tab twice)
set show-all-if-ambiguous on

# Ignore case when completing filenames
set completion-ignore-case on

# Treat hyphens and underscores as equivalent when completing
# e.g., typing "my_file" also matches "my-file" and vice versa
set completion-map-case on

# Show file type indicators in completion (/, @, *, =)
set visible-stats on

# Add slash to directory names when completing
set mark-directories on
set mark-symlinked-directories on

# Colorize file type indicators in completions (uses LS_COLORS)
set colored-stats on

# Highlight the common prefix of possible completions in a different color
# so you can see what you've typed vs. what will be completed (Bash 4.4+)
set colored-completion-prefix on

# Display the common prefix before cycling through menu completions
set menu-complete-display-prefix on

# ------------------------------------------------------------------------------
# History Configuration
# ------------------------------------------------------------------------------

# Enable prefix-based history search with Up/Down arrows
# Type a partial command, then press Up/Down to cycle through only matching
# history entries (e.g., type "git" then Up to find previous git commands)
"\e[A": history-search-backward
"\e[B": history-search-forward

# Ctrl+Up/Down for plain sequential history (ignores typed prefix)
# Useful when you want to browse all history regardless of current input
"\e[1;5A": previous-history
"\e[1;5B": next-history

# ------------------------------------------------------------------------------
# Completion Enhancements
# ------------------------------------------------------------------------------

# TAB cycles through completions one by one (instead of listing all)
# This replaces the default "complete" action with "menu-complete"
TAB: menu-complete

# Shift+TAB cycles backwards through the same completion menu
"\e[Z": menu-complete-backward

# Show all completions on first TAB if ambiguous (duplicate of line above
# in General Behavior, but kept here for grouping with completion bindings)
set show-all-if-ambiguous on

# Don't paginate completion results — show them all at once even if the
# list is long; avoids the "--More--" prompt
set page-completions off

# Display the common prefix before cycling through completions
set menu-complete-display-prefix on

# ------------------------------------------------------------------------------
# Keyboard Shortcuts (Emacs Mode)
# ------------------------------------------------------------------------------
# Most common shortcuts (enabled by default with emacs mode):
#
# Ctrl+A    - Move to beginning of line
# Ctrl+E    - Move to end of line
# Ctrl+K    - Delete from cursor to end of line
# Ctrl+U    - Delete from cursor to beginning of line
# Ctrl+W    - Delete word before cursor
# Ctrl+L    - Clear screen
# Ctrl+R    - Search command history backwards
# Ctrl+S    - Search command history forwards
# Alt+B     - Move back one word
# Alt+F     - Move forward one word
# Alt+D     - Delete word after cursor
# Alt+.     - Insert last argument from previous command
# Ctrl+X Ctrl+E - Open current command in $EDITOR

# Additional custom shortcuts

# Alt+Left/Right to move by word (in addition to Alt+B/F)
"\e[1;3D": backward-word
"\e[1;3C": forward-word

# Ctrl+Left/Right to move by word (alternative)
"\e[1;5D": backward-word
"\e[1;5C": forward-word

# ------------------------------------------------------------------------------
# Special Sequences
# ------------------------------------------------------------------------------

# Make Ctrl+W delete up to the previous slash (useful for editing paths)
# Default Ctrl+W uses unix-word-rubout which stops at whitespace only
# Example: /usr/local/bin → Ctrl+W → /usr/local/ → Ctrl+W → /usr/
"\C-w": unix-filename-rubout

# Alt+Backspace: delete the previous word (stops at word boundaries, not slashes)
# This gives you both path-aware (Ctrl+W) and word-aware (Alt+Backspace) deletion
"\e\C-h": backward-kill-word

# ------------------------------------------------------------------------------
# Vi Mode Shortcuts (if enabled)
# ------------------------------------------------------------------------------
# Uncomment if using Vi mode (set editing-mode vi above)
#
# Normal mode shortcuts:
# - ESC or Ctrl+[ enters normal mode
# - i enters insert mode at cursor
# - a enters insert mode after cursor
# - A enters insert mode at end of line
# - 0 moves to beginning of line
# - $ moves to end of line
# - w/b moves forward/backward by word
# - dd deletes line
# - d$ deletes to end of line
# - d0 deletes to beginning of line
# - yy yanks (copies) line
# - p pastes after cursor
# - / searches history forward
# - ? searches history backward
# - n/N repeat search forward/backward
# - v opens current line in $EDITOR

# ------------------------------------------------------------------------------
# Suggested Additions (Uncomment to Enable)
# ------------------------------------------------------------------------------
# Additional word manipulation bindings:
#
# Ctrl+T: Transpose (swap) the character before the cursor with the one under it
# "\C-t": transpose-chars
#
# Alt+T: Transpose (swap) the word before the cursor with the one after it
# "\et": transpose-words
#
# Alt+U: Uppercase the current word (from cursor to end of word)
# "\eu": upcase-word
#
# Alt+L: Lowercase the current word
# "\el": downcase-word
#
# Alt+C: Capitalize the current word
# "\ec": capitalize-word
#
# Ctrl+X Ctrl+E: Edit the current command line in $EDITOR (already default)
#
# Ctrl+]: Character search — jump forward to next occurrence of a typed char
# (built-in, no config needed — similar to Vim's f command)
#
# Vi mode indicator in prompt (if using vi editing-mode):
# set show-mode-in-prompt on
# set vi-ins-mode-string "(ins)"
# set vi-cmd-mode-string "(cmd)"

# ------------------------------------------------------------------------------
# Notes and Tips
# ------------------------------------------------------------------------------
#
# 1. TEST CHANGES: After editing this file, reload with:
#    bind -f ~/.inputrc
#
# 2. VIEW CURRENT BINDINGS: To see all active readline bindings:
#    bind -P
#
# 3. VIEW KEY SEQUENCES: To see what sequence a key sends:
#    Press Ctrl+V, then press the key
#
# 4. DEBUGGING: To see if readline is reading this file:
#    bind -v | grep editing-mode
#
# 5. VI MODE INDICATOR: Add this to .bashrc to show mode in prompt:
#    set show-mode-in-prompt on
#    (Shows (ins) or (cmd) in Vi mode)
