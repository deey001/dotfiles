# ==============================================================================
# .common_shell — Shared Environment for Bash and Zsh
# ==============================================================================
# LOCATION:  ~/.common_shell  (symlinked by install.sh via stow/shell)
# SOURCED BY: ~/.bashrc (section 12) and ~/.zshrc (top of file)
#
# PURPOSE:
#   This file is the single source of truth for environment variables and
#   small utility functions that must behave identically in every shell.
#   It is intentionally lean — aliases live in ~/.bash_aliases (which is
#   also sourced by .zshrc), keeping this file focused on ENV only.
#
# WHAT BELONGS HERE:
#   ✓ Active theme sourcing (loads ~/.config/dotfiles/theme.sh)
#   ✓ Environment variables (EDITOR, PAGER, LANG, etc.)
#   ✓ Short utility functions needed in all shells (mkcd)
#   ✗ Aliases — use ~/.bash_aliases instead
#   ✗ Shell-specific options (shopts, setopt, bindkey) — use the shell's own rc
#   ✗ Tool initializations (starship, zoxide, fzf) — use the shell's own rc
#
# LOAD ORDER (Bash):
#   .bash_profile → .bashrc → .common_shell (here) → .bash_aliases → tools
#
# LOAD ORDER (Zsh):
#   .zshrc (top) → .common_shell (here) → .bash_aliases → tools → starship
# ==============================================================================

# ── Active Theme ──────────────────────────────────────────────────────────────
# Sources ~/.config/dotfiles/theme.sh — a symlink managed by the active stow
# theme package (stow/theme-catppuccin-mocha/ or stow/theme-catppuccin-latte/).
#
# What the theme file exports (full list in themes/catppuccin-mocha.sh):
#   DOTFILES_THEME              — slug, e.g. "catppuccin-mocha"
#   DOTFILES_COLOR_*            — full 26-color hex palette
#   BAT_THEME                   — bat syntax highlighting theme name
#   DOTFILES_WEZTERM_THEME      — WezTerm color scheme name
#   DOTFILES_FZF_COLORS         — ready-to-use --color= value for FZF
#   DOTFILES_FZFTAB_COLORS      — same, for fzf-tab zstyle in Zsh
#
# Switch themes:  make theme-latte  /  make theme-mocha
# If no theme is stowed yet, this silently no-ops; tools fall back to their
# own hard-coded defaults in each rc file.
[ -f "$HOME/.config/dotfiles/theme.sh" ] && source "$HOME/.config/dotfiles/theme.sh"

# ── Environment Variables ─────────────────────────────────────────────────────

# EDITOR / VISUAL — preferred text editor for CLI programs.
# EDITOR: used by non-interactive programs (git commit messages, crontab -e, sudoedit).
# VISUAL: used by interactive terminal programs (some respect VISUAL over EDITOR).
# Both set to nvim; if nvim is absent, .bashrc overrides with a fallback loop
# (tries nvim → vim → vi → nano in order).
export EDITOR='nvim'
export VISUAL='nvim'

# PAGER — program used to paginate long output (man pages, git log, help text).
# 'less' is the POSIX standard pager. LESS='-R' (set in .bashrc) enables ANSI
# color passthrough so colored output from bat/delta/git isn't stripped.
export PAGER='less'

# LANG / LC_ALL — force UTF-8 locale globally.
# LANG sets the default for all locale categories (LC_CTYPE, LC_MESSAGES, etc.).
# LC_ALL overrides every individual LC_* variable — ensures consistency even
# when connecting to systems that export a different locale via SSH.
# Without UTF-8: grep/awk/Python can produce encoding errors, non-ASCII filenames
# may be mangled, and some tools (like bat) silently fall back to ASCII rendering.
export LANG='en_US.UTF-8'
export LC_ALL='en_US.UTF-8'

# ── Functions ─────────────────────────────────────────────────────────────────

# mkcd — Make a directory and immediately enter it.
# USAGE:  mkcd my-new-project
#         mkcd ~/projects/deep/nested/path
# WHY:    'mkdir foo && cd foo' is the most common two-step in terminal work.
#         The -p flag creates all intermediate directories silently (no error
#         if path already exists). Available in both Bash and Zsh via this file.
mkcd() { mkdir -p "$1" && cd "$1"; }
