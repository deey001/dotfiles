# ==============================================================================
# .common_shell — Shared Aliases and Exports for Bash and Zsh
# ==============================================================================
# Sourced by both .bashrc and .zshrc. Keep this file lean — only put things
# here that are NOT already in .bash_aliases and must work in every shell
# (including non-bash shells like zsh). Full alias definitions live in
# .bash_aliases (which is also sourced by .zshrc).
# ==============================================================================

# ── Environment Variables ────────────────────────────────────────────────────
export EDITOR='nvim'
export VISUAL='nvim'
export PAGER='less'
export LANG='en_US.UTF-8'
export LC_ALL='en_US.UTF-8'

# ── Functions ────────────────────────────────────────────────────────────────
# mkcd — Create and enter a directory
mkcd() { mkdir -p "$1" && cd "$1"; }
