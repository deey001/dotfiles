# ==============================================================================
# .gitattributes — Git File Attribute Rules
# ==============================================================================
# Controls how Git handles line endings, diff behavior, and file types.
# Symlinked to ~/.gitattributes by install.sh.
#
# PURPOSE:
#   Ensures consistent line endings across macOS, Linux, and Windows (WSL).
#   Shell scripts MUST use LF — CRLF line endings will break them.
#
# HOW IT WORKS:
#   "text eol=lf" tells Git to always normalize to LF in the repo
#   and check out as LF on every platform (even Windows).
# ==============================================================================

# --- Shell Scripts ------------------------------------------------------------
# Force LF endings so scripts run correctly on all Unix-like systems.
# Without this, Windows checkouts may introduce CRLF and break shebangs.
*.sh text eol=lf
*.bash text eol=lf

# --- Config Files -------------------------------------------------------------
# Dotfiles and config files sourced by Bash/tmux/etc also need LF.
*.conf text eol=lf
*.tmux text eol=lf

# --- Specific Dotfiles --------------------------------------------------------
# Explicitly list dotfiles that lack extensions — Git can't infer their type.
.bashrc text eol=lf
.profile text eol=lf
.bash_aliases text eol=lf
.bash_functions text eol=lf
.bash_exports text eol=lf

