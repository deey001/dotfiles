# ==============================================================================
# .bash_wrappers — Wrapper Functions for Enhanced Command Output
# ==============================================================================
# Sourced by: .bashrc (after .bash_functions)
# Purpose:    Shell functions that "wrap" existing commands to add color,
#             formatting, or extra behavior while preserving the original
#             interface. Unlike aliases, wrappers can inject environment
#             variables or add control flow around the original command.
#
# Why wrappers instead of aliases?
#   - Aliases can't set per-invocation environment variables.
#   - Aliases can't contain logic (if/for/while).
#   - A function named `man` shadows `/usr/bin/man` but can still call it
#     via `env man` or `command man`, giving us a transparent override.
#
# Dependencies: less (for man pager), git (for whatsgoingon), tput (for bold)
# ==============================================================================

# ── Colored man pages ──────────────────────────────────────────────────────────
# Wraps man to inject LESS_TERMCAP_* variables that colorize output in less.
# This works because man uses less as its pager, and less interprets these
# termcap variables to apply ANSI styling to different semantic elements.
#
# Usage:   man git   (works exactly like normal man, but with colors)
# Params:  $@ — passed through to the real man command unchanged
man() {
    env LESS_TERMCAP_mb=$'\E[01;31m' \
    LESS_TERMCAP_md=$'\E[01;38;5;74m' \
    LESS_TERMCAP_me=$'\E[0m' \
    LESS_TERMCAP_se=$'\E[0m' \
    LESS_TERMCAP_so=$'\E[01;33;03;40m' \
    LESS_TERMCAP_ue=$'\E[0m' \
    LESS_TERMCAP_us=$'\E[04;38;5;146m' \
    man "$@"
}
# ── LESS_TERMCAP variable reference ───────────────────────────────────────────
# mb = begin blinking       (red — rarely used, marks errors)
# md = begin bold            (blue — headings and command names)
# me = end mode              (reset all styling)
# se = end standout          (reset status/search highlight bar)
# so = begin standout        (yellow on dark gray — search matches & status bar)
# ue = end underline         (reset underline)
# us = begin underline       (light purple — flags, arguments, emphasis)

# ── Git multi-repo status ─────────────────────────────────────────────────────

# whatsgoingon — Show git status for every repo in the current directory
# Usage:   cd ~/projects && whatsgoingon
# Returns: For each child directory that contains a .git folder, prints the
#          directory name in bold followed by either "is clean" or the short
#          status output (modified/untracked files).
# Note:    Useful for quickly scanning a workspace of multiple repos.
whatsgoingon() {
    for i in $(find . -maxdepth 1 -type d | sed -e 's/\.\///' -e '/\./d'); do
        if [ -d "$i/.git" ]; then
            pushd "$i" >/dev/null 2>&1 || continue
            echo "$(tput bold)$i$(tput sgr0)"        # Bold repo name
            if [ -z "$(git status --porcelain)" ]; then
                echo "is clean"                       # No uncommitted changes
            else
                git status -s                         # Short format: M/A/?? markers
            fi
            popd >/dev/null
        fi
    done
}

