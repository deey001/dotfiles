# ==============================================================================
# .bash_local — Machine-Local Overrides (NOT tracked in git)
# ==============================================================================
# Copy to ~/.bash_local and edit for this machine only.
# Sourced at the end of .bashrc and .zshrc.
# Use for: secrets, tokens, machine-specific PATH, work proxies, etc.
#
# Setup:
#   cp ~/dotfiles/scripts/.bash_local.template ~/.bash_local
# ==============================================================================

# ── Secrets & tokens (never commit these) ────────────────────────────────────
# export GITHUB_TOKEN=""
# export AWS_ACCESS_KEY_ID=""
# export OPENAI_API_KEY=""

# ── Machine-specific PATH ─────────────────────────────────────────────────────
# export PATH="$HOME/my-tool/bin:$PATH"

# ── Go (if installed on this machine) ────────────────────────────────────────
# export GOPATH="$HOME/go"
# export PATH="$GOPATH/bin:/usr/local/go/bin:$PATH"

# ── rbenv (if used on this machine) ──────────────────────────────────────────
# if [[ -d "$HOME/.rbenv" ]]; then
#     export PATH="$HOME/.rbenv/bin:$PATH"
#     eval "$(rbenv init - bash)"
# fi

# ── CDPATH (if you want quick cd from anywhere) ───────────────────────────────
# export CDPATH=":$HOME:$HOME/projects:$HOME/work"

# ── Work proxy ────────────────────────────────────────────────────────────────
# export HTTP_PROXY="http://proxy.corp:8080"
# export HTTPS_PROXY="$HTTP_PROXY"
# export NO_PROXY="localhost,127.0.0.1,.corp"

# ── SSH agent (if not handled by systemd or keychain) ─────────────────────────
# eval "$(ssh-agent -s)"
# ssh-add ~/.ssh/id_ed25519
