[user]
	name = deey001
	email = dvillazon@gmail.com

# Machine-specific settings (credential helper, signing key, a work email that
# overrides the one above) go in ~/.gitconfig.local, which is not tracked.
[include]
	path = ~/.gitconfig.local

[core]
	editor = nvim
	pager = delta
	autocrlf = input
[init]
	defaultBranch = main
[diff]
	algorithm = histogram
	colorMoved = default
[merge]
	conflictStyle = diff3
	tool = nvimdiff
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[fetch]
	prune = true
[rerere]
	enabled = true

[delta]
	navigate = true
	line-numbers = true
[interactive]
	diffFilter = delta --color-only

[alias]
	st = status
	co = checkout
	cob = checkout -b
	cm = commit -m
	can = commit --amend --no-edit
	dfs = diff --staged
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	last = log -1 HEAD --stat
	undo = reset HEAD~1 --mixed
	unstage = reset HEAD --
