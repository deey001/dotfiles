# Fix-ups applied after Omarchy's default/bash/rc on machines without Omarchy.
# Kept separate so default/ stays a verbatim copy of Omarchy's files.

# Omarchy's launchers don't exist here
[[ $EDITOR == omarchy-* ]] && export EDITOR=nvim SUDO_EDITOR=nvim
[[ $BROWSER == omarchy-* ]] && unset BROWSER

# macOS already has open(1)
[[ $OSTYPE == darwin* ]] && unset -f open

# Homebrew on macOS (Apple Silicon needs shellenv for PATH)
if command -v brew &> /dev/null; then
  eval "$(brew shellenv)"
fi

# Prefer installer nvim (LazyVim) over distro nvim. default/ APPENDs ~/.local/bin
# (and gets overwritten by --sync-omarchy), so strip any existing entry and PREPEND.
_local_bin="$HOME/.local/bin"
case ":$PATH:" in
  *":$_local_bin:"*)
    PATH=":${PATH}:"
    PATH="${PATH//:$_local_bin:/:}"
    PATH="${PATH#:}"; PATH="${PATH%:}"
    ;;
esac
export PATH="$_local_bin${PATH:+:$PATH}"
unset _local_bin

# Completion on macOS (Homebrew) — Omarchy only looks in /usr/share
if [[ -z ${BASH_COMPLETION_VERSINFO:-} && -r ${HOMEBREW_PREFIX:-/opt/homebrew}/etc/profile.d/bash_completion.sh ]]; then
  source "${HOMEBREW_PREFIX:-/opt/homebrew}/etc/profile.d/bash_completion.sh"
fi

# fzf keybindings — Omarchy only looks in Arch's /usr/share/fzf
if command -v fzf &> /dev/null && ! declare -F __fzf_history__ &> /dev/null; then
  if fzf_init=$(fzf --bash 2> /dev/null); then
    eval "$fzf_init"
  else # fzf < 0.48 (Debian/Ubuntu)
    for f in /usr/share/doc/fzf/examples/{completion,key-bindings}.bash; do
      [[ -r $f ]] && source "$f"
    done
  fi
  unset f fzf_init
fi

# Terminals like ghostty/kitty/foot send a TERM that servers often lack terminfo
# for, which breaks tmux, nvim and less. Fall back to a TERM every host knows.
if command -v infocmp &> /dev/null && ! infocmp "$TERM" &> /dev/null; then
  export TERM=xterm-256color
fi

# Omarchy defines these names in default/bash. That tree stays verbatim.
# Off Omarchy, drop a name when this machine has no such command.
# Do not point the name at a different program.
_drop_alias() {
  command -v "$2" &> /dev/null || unalias "$1" 2> /dev/null || true
}
_drop_alias a omarchy-agent
_drop_alias c opencode
_drop_alias cx claude
_drop_alias cy codex
_drop_alias d docker
_drop_alias r rails
_drop_alias t tmux
_drop_alias h herdr
_drop_alias mup mise
_drop_alias g git
_drop_alias gcm git
_drop_alias gcam git
_drop_alias gcad git
unset -f _drop_alias

if ! command -v fzf &> /dev/null || ! command -v bat &> /dev/null; then
  unalias ff 2> /dev/null || true
  unalias eff 2> /dev/null || true
  unset -f sff 2> /dev/null || true
fi

if ! command -v tmux &> /dev/null || ! command -v opencode &> /dev/null; then
  unalias ic 2> /dev/null || true
  unalias icx 2> /dev/null || true
fi
if ! command -v tmux &> /dev/null || ! command -v claude &> /dev/null; then
  unalias ix 2> /dev/null || true
  unalias icx 2> /dev/null || true
fi

command -v mise &> /dev/null || unset -f ga 2> /dev/null || true
command -v gum &> /dev/null || unset -f gd 2> /dev/null || true
command -v nvim &> /dev/null || unset -f n 2> /dev/null || true
command -v xdg-open &> /dev/null || unset -f open 2> /dev/null || true

# envs points man at bat. Without bat, man keeps its own pager.
if ! command -v bat &> /dev/null; then
  unset MANPAGER MANROFFOPT
fi
